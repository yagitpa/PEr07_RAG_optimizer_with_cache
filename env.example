# Настройки RAG-ассистента
# Скопируйте этот файл в .env и заполните OPENAI_API_KEY.
# Любую строку можно закомментировать - тогда возьмётся значение
# по умолчанию из config.py (блок DEFAULT_*).

# --- Доступ к OpenAI ------------------------------------------------------

# Обязательно. Ключ используется и для эмбеддингов, и для генерации ответов.
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Необязательно. Оставьте строку закомментированной, чтобы обращаться напрямую
# в OpenAI по адресу https://api.openai.com/v1
# Раскомментировать и заполнить нужно только при работе через прокси или
# совместимый сервис. Пустое значение недопустимо: библиотека openai читает эту
# переменную окружения сама и пустую строку принимает за адрес, после чего
# запрос уходит без протокола и падает с ошибкой соединения.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Таймаут одного HTTP-запроса в секундах
OPENAI_TIMEOUT=60

# Сколько раз повторить запрос при сетевой ошибке
OPENAI_MAX_RETRIES=2

# --- Языковая модель ------------------------------------------------------

# Модель для генерации ответов
LLM_MODEL=gpt-3.5-turbo

# Разброс ответов: 0 - максимально предсказуемо, 2 - максимально свободно
LLM_TEMPERATURE=0.7

# Верхняя граница длины ответа в токенах
LLM_MAX_TOKENS=500

# --- Эмбеддинги -----------------------------------------------------------

# Модель эмбеддингов.
# Альтернативы: text-embedding-3-large (точнее, дороже), text-embedding-ada-002 (старая)
# Внимание: после смены модели базу нужно переиндексировать - векторы разных
# моделей несравнимы между собой.
EMBEDDING_MODEL=text-embedding-3-small

# Сколько текстов уходит в один запрос к API при индексации
EMBEDDING_BATCH_SIZE=100

# --- Векторное хранилище --------------------------------------------------

# Папка с базой ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Имя коллекции
CHROMA_COLLECTION=rag_documents

# Метрика расстояния: cosine, l2 или ip.
# cosine нужен, чтобы показатель похожести читался как 1 - расстояние.
# Метрика задаётся при создании коллекции: чтобы её сменить, удалите папку
# CHROMA_PERSIST_DIR и проиндексируйте базу заново.
CHROMA_DISTANCE=cosine

# Отправка анонимной статистики в ChromaDB
CHROMA_TELEMETRY=false

# --- Разбивка документов --------------------------------------------------

# Размер чанка в символах
CHUNK_SIZE=500

# Перекрытие соседних чанков в символах, должно быть меньше CHUNK_SIZE
CHUNK_OVERLAP=50

# После изменения этих двух значений нужна переиндексация (команда reindex)

# --- Поиск ----------------------------------------------------------------

# Сколько фрагментов уходит в контекст модели.
# Домашнее задание, этап 4: поменять на 7 и сравнить ответы.
TOP_K=3

# Искать только по источникам, в имени которых есть эта подстрока.
# Пусто = искать по всей базе. Пример: Python
SOURCE_FILTER=

# --- Кеш ответов ----------------------------------------------------------

# Файл кеша
CACHE_FILE=cache.json

# Выключение кеша полезно, чтобы замерить время без него
CACHE_ENABLED=true

# Учитывать модель, температуру, top_k и фильтр в ключе кеша.
# При true смена TOP_K автоматически даёт промах кеша, и сравнение ответов
# в задании работает. При false старый ответ вернётся вопреки новым настройкам.
CACHE_KEY_INCLUDES_PARAMS=true

# --- Отображение времени --------------------------------------------------

# Знаков после запятой в выводе времени. 5 = точность 0.00001 секунды
TIME_PRECISION=5

# Показывать разбивку времени по этапам
SHOW_TIMING_BREAKDOWN=true

# --- Демонстрационный режим и режим замеров -------------------------------

# Вопросы через символ |
DEMO_QUESTIONS=Привет, что ты умеешь?|Что такое RAG?|Что такое ИИ?
